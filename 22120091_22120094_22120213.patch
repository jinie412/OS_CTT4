+extern uint64 sys_trace(void);
+extern uint64 sys_sysinfo(void);
 
 // An array mapping syscall numbers from syscall.h
 // to the function that handles the system call.
@@ -126,22 +128,99 @@ static uint64 (*syscalls[])(void) = {
 [SYS_link]    sys_link,
 [SYS_mkdir]   sys_mkdir,
 [SYS_close]   sys_close,
+[SYS_trace]   sys_trace,
+[SYS_sysinfo] sys_sysinfo,
+};
+struct Infor {
+    char *name;
+    int numberOfArgs;
+    char *argumentType;
 };
 
-void
-syscall(void)
-{
-  int num;
-  struct proc *p = myproc();
+static struct Infor syscallsInfo[] = {
+    {"", 0, ""},
+    {"fork", 0, ""},
+    {"exit", 1, "i"},
+    {"wait", 1, "p"},
+    {"pipe", 1, "p"},
+    {"read", 3, "ipi"},
+    {"kill", 2, "ii"},
+    {"exec", 2, "sp"},
+    {"fstat", 2, "ip"},
+    {"chdir", 1, "s"},
+    {"dup", 1, "i"},
+    {"getpid", 0, ""},
+    {"sbrk", 1, "i"},
+    {"sleep", 1, "i"},
+    {"uptime", 0, ""},
+    {"open", 2, "si"},
+    {"write", 3, "ipi"},
+    {"mknod", 3, "sii"},
+    {"unlink", 1, "s"},
+    {"link", 2, "ss"},
+    {"mkdir", 1, "s"},
+    {"close", 1, "i"},
+    {"trace", 1, "i"}};
 
-  num = p->trapframe->a7;
-  if(num > 0 && num < NELEM(syscalls) && syscalls[num]) {
-    // Use num to lookup the system call function for num, call it,
-    // and store its return value in p->trapframe->a0
-    p->trapframe->a0 = syscalls[num]();
-  } else {
-    printf("%d %s: unknown sys call %d\n",
-            p->pid, p->name, num);
-    p->trapframe->a0 = -1;
-  }
+void syscall(void) {
+    int num;
+    struct proc *p = myproc();
+    int flag = 0;
+    num = p->trapframe->a7;
+
+    // num = *(int*)0;
+    if (num > 0 && num < NELEM(syscalls) && syscalls[num]) {
+        // Use num to lookup the system call function for num, call it,
+        // and store its return value in p->trapframe->a0
+        if (p->mask & (1 << num)) {
+            if (num != 2) {
+                flag = 1;
+                struct Infor *info = &syscallsInfo[num];
+                printf("%d: syscall %s(", p->pid, info->name);
+
+                for (int i = 0; i < info->numberOfArgs; i++) {
+                    if (i > 0) {
+                        printf(", ");
+                    }
+
+                    char type = info->argumentType[i];
+                    uint64 arg;
+
+                    switch (i) {
+                        case 0: arg = p->trapframe->a0; break;
+                        case 1: arg = p->trapframe->a1; break;
+                        case 2: arg = p->trapframe->a2; break;
+                        case 3: arg = p->trapframe->a3; break;
+                        case 4: arg = p->trapframe->a4; break;
+                        case 5: arg = p->trapframe->a5; break;
+                        default: arg = 0;
+                    }
+
+                    if (type == 'i') {
+                        printf("%ld", arg);
+                    } else if (type == 'p') {
+                        printf("%p", (void *)arg);
+                    } else if (type == 's') {
+                        char buf[512];
+                        int len = fetchstr(arg, buf, sizeof(buf));
+                        if (len >= 0) {
+                            printf("\"%s\"", buf);
+                        } else {
+                            printf("null");
+                        } 
+                    }
+                }
+            }
+        }
+
+        p->trapframe->a0 = syscalls[num]();
+        
+        if (flag == 1) {
+            printf(") -> %d\n", (int)p->trapframe->a0);
+        }
+
+    } else {
+        printf("%d %s: unknown sys call %d\n", p->pid, p->name, num);
+        p->trapframe->a0 = -1;
+    }
 }

+// Ham get_nproc de dem so tien trinh khong o trang thai  UNUSED
+uint64
+get_nproc(void)
+{
+    struct proc *p;
+    int count = 0;
+
+    for (p = proc; p < &proc[NPROC]; p++) {
+        if (p->state != UNUSED)
+            count++;
+    }
+
+    return count;
+}

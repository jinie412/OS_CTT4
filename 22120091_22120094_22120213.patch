@@ -91,3 +91,17 @@ kalloc(void)
   return (void*)r;
 }
 
+// Ham get_freemem de tinh bo nho trong
+uint64
+get_freemem(void)
+{
+    struct run *r;
+    uint64 free_mem = 0;
+
+    acquire(&kmem.lock);
+    for (r = kmem.freelist; r; r = r->next)
+        free_mem += PGSIZE;
+    release(&kmem.lock);
+
+    return free_mem;
+}

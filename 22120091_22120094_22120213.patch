diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index 3b4d5bd..a2eea92 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -5,6 +5,7 @@
 #include "memlayout.h"
 #include "spinlock.h"
 #include "proc.h"
+#include "sysinfo.h"
 
 uint64
 sys_exit(void)
@@ -91,3 +92,36 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+// trace
+uint64
+sys_trace(void) {
+    int maskTrace;
+
+    argint(0,&maskTrace);
+    
+    struct proc *p = myproc();
+    p->mask = maskTrace;
+
+    return 0;
+}
+
+// sysinfo
+extern uint64 get_freemem(void);
+extern uint64 get_nproc(void);
+
+uint64
+sys_sysinfo(void)
+{
+    uint64 addr;
+    struct sysinfo info;
+    argaddr(0, &addr);
+
+    info.freemem = get_freemem();
+    info.nproc = get_nproc();
+
+    if (copyout(myproc()->pagetable, addr, (char *)&info, sizeof(info)) < 0)
+        return -1;
+    return 0;
+}
+

diff --git a/kernel/syscall.c b/kernel/syscall.c
index ed65409..7773300 100644
--- a/kernel/syscall.c
+++ b/kernel/syscall.c
@@ -101,6 +101,8 @@ extern uint64 sys_unlink(void);
